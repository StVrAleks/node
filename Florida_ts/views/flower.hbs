

<div id="conteiner" class="container-center">
    <div id="mist00" style="color: red; text-align: center; margin-bottom: 15px; font-weight: bold;"></div>
    
    <!-- Главная обертка страницы с data-атрибутом ID цветка -->
    <div class="product-page-wrapper" data-flower-id="{{id}}">
        
        <!-- ЛЕВАЯ ЧАСТЬ: Галерея картинок -->
        <div class="product-gallery">
            <div id="imgsFl" class="gallery-grid">
                <!-- Сюда JS динамически рендерит картинки товара -->
            </div>
        </div>

        <!-- ПРАВАЯ ЧАСТЬ: Информация и управление -->
        <div class="product-info-block">
            <div class="product-meta">
                <span id="vidFl" class="product-category">...</span>
                <span id="flStatus" class="product-status">...</span>
            </div>

            <h1 id="titleFl" class="product-main-title">...</h1>
            
            <div class="price-box">
                <span id="priceFl" class="product-price">...</span> <span class="currency">BYN</span>
            </div>

            <!-- БЛОК ФУНКЦИОНАЛА: Количество и Кнопки -->
            <div class="product-actions-box">
                <div class="quantity-selector">
                    <button type="button" class="qty-btn" id="qty-minus">−</button>
                    <input type="number" id="product-qty" value="1" min="1" readonly>
                    <button type="button" class="qty-btn" id="qty-plus">+</button>
                </div>

                <!-- Кнопка Корзины -->
                <button type="button" id="add-to-cart-btn" class="action-btn btn-cart">
                    <svg viewBox="0 0 24 24" class="btn-icon"><path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/></svg>
                    <span class="btn-text">В корзину</span>
                </button>

                <!-- Кнопка Избранного -->
                <button type="button" id="fav-toggle-btn" class="action-btn btn-fav" title="Добавить в избранное">
                    <svg viewBox="0 0 24 24" class="btn-icon icon-heart"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                </button>
            </div>

            <!-- БЛОК ОПИСАНИЯ -->
            <div class="product-description-section">
                <h3>Описание букета</h3>
                <div id="descr"></div>
            </div>
        </div>

    </div>
</div>
<style>
.container-center {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
    font-family: 'Montserrat', 'Segoe UI', sans-serif;
}

/* Сетка страницы товара: 2 колонки (Галерея | Инфо) */
.product-page-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    margin-top: 20px;
}

@media (max-width: 768px) {
    .product-page-wrapper { grid-template-columns: 1fr; gap: 30px; }
}

/* Красивая сетка для картинок */
.gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 15px;
}
.gallery-grid img {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 8px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    transition: transform 0.3s ease;
}
.gallery-grid img:hover {
    transform: scale(1.03);
}

/* Мета-информация */
.product-meta {
    display: flex;
    gap: 15px;
    align-items: center;
    margin-bottom: 10px;
}
.product-category {
    font-size: 14px;
    text-transform: uppercase;
    color: #666;
    letter-spacing: 1px;
}
.product-status {
    font-size: 12px;
    padding: 4px 10px;
    background-color: #e8f5e9;
    color: #2e7d32;
    border-radius: 20px;
    font-weight: 600;
}

.product-main-title {
    font-size: 32px;
    font-weight: 700;
    color: #181d19;
    margin: 0 0 15px 0;
}

.price-box {
    margin-bottom: 30px;
}
.product-price {
    font-size: 28px;
    font-weight: 700;
    color: #181d19;
}
.currency { font-size: 18px; font-weight: 600; color: #555; margin-left: 5px; }

/* Управление количеством */
.product-actions-box {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 40px;
    flex-wrap: wrap;
}
.quantity-selector {
    display: flex;
    align-items: center;
    border: 1px solid #ccc;
    border-radius: 4px;
    overflow: hidden;
}
.qty-btn {
    background: #f5f5f5;
    border: none;
    width: 40px;
    height: 40px;
    font-size: 18px;
    cursor: pointer;
    transition: background 0.2s;
}
.qty-btn:hover { background: #e0e0e0; }
#product-qty {
    width: 50px;
    height: 40px;
    border: none;
    text-align: center;
    font-size: 16px;
    font-weight: 600;
    -moz-appearance: textfield;
}
#product-qty::-webkit-outer-spin-button,
#product-qty::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

/* Кнопки действий */
.action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    border: none;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
}
.btn-cart {
    background-color: #181d19;
    color: white;
    padding: 0 30px;
    gap: 10px;
}
.btn-cart:hover { background-color: #2c352e; transform: translateY(-1px); }
.btn-cart.in-cart { background-color: #4caf50; } /* Статус: Товар уже в корзине */

.btn-fav {
    background-color: #f5f5f5;
    color: #999;
    width: 40px;
    border: 1px solid #ddd;
}
.btn-fav:hover { color: #900; background-color: #f9f9f9; }
.btn-fav.active { color: #900; background-color: #ffebee; border-color: #ffcdd2; } /* Статус: Лайкнуто */

.btn-icon { width: 18px; height: 18px; fill: currentColor; }

/* Стилизация описания */
.product-description-section h3 {
    font-size: 18px;
    border-bottom: 1px solid #eee;
    padding-bottom: 10px;
    margin-bottom: 15px;
}
.descrStyle {
    font-size: 16px;
    font-weight: 600;
    color: #333;
    margin-bottom: 8px;
}    
</style>
<script type="module" src="/dist/src/flower.js"></script>