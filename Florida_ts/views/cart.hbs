
{{#section 'css'}}
    <!-- Этот файл скачает только тот, кто открыл карточку цветка -->
    <link rel="stylesheet" href="/public/css/pages/page-cart.css">
{{/section}}
<div class="cart-page-wrapper">
    
    <!-- Сюда JS выведет сообщение "Вы забыли авторизоваться!" или ошибки -->
    <div id="cart-error-msg"></div>

    <div id="cart-content-wrapper">
        <h3>Корзина</h3>
        <!-- Сетка для динамического вывода строк товаров из JS -->
        <div class="cart-products-list" id="cart-products-grid">
            <!-- Сюда carts.js вставит строки с букетами -->
        </div>

        <div class="cart-total-score" id="total-box">
            Итого: <span id="cart-final-total-price">0.00</span> BYN
        </div>

        <!-- Форма оформления заказа для доставки в г. Могилев -->
        <form id="checkout-form" class="checkout-form-container">
            <h3>Оформление доставки букета</h3>
            
            <div class="form-field">
                <label for="cart-phone">Телефон получателя</label>
                <input type="text" id="cart-phone" placeholder="+375 (29) 111-11-11" required >
            </div>

            <div class="form-field">
                <label for="cart-address">Адрес доставки в г. Могилев</label>
                <input type="text" id="cart-address" placeholder="Улица, дом, квартира" required >
            </div>

            <button type="submit" id="checkout-submit-btn" class="class_control_button">
                Подтвердить и заказать букет
            </button>
        </form>
    </div>
</div>

<script type="module" src="/dist/src/carts.js"></script>