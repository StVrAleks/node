<div class="catalog-container size--5" style="padding-top: 30px; min-height: 60vh;">
    <h2>Моё Избранное</h2>
    <div id="favorites-error-msg" style="color: red; margin-bottom: 15px;"></div>

    <!-- Сетка для динамического вывода карточек цветов -->
    <div class="products-grid" id="favorites-products-grid">
        <!-- Сюда JS будет рендерить товар -->
    </div>

    <!-- БЛОК ПАГИНАЦИИ (Аналогично вашей админке) -->
    <div id="pageView" class="pagination-container" style="display: flex; justify-content: center; align-items: center; gap: 15px; margin-top: 40px;">
        <input type="button" class="class_control_button" value="<<" id="pre-fav" style="background-color: #181d19; color: white;">
        <input type="text" id="numPage-fav" value="1" readonly style="width: 40px; text-align: center; border: 1px solid #ccc; padding: 5px;">
        <input type="button" class="class_control_button" value=">>" id="next-fav" style="background-color: #181d19; color: white;">
    </div>
</div>
<script  type="module" src="/dist/src/favorites.js"></script>