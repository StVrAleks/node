<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Flowerida - цветы для клумбы</title>
    <link rel="stylesheet"  href="/public/css/style.css">
    <link rel="stylesheet"  href="/public/css/adminka.css">
    <link rel="stylesheet"  href="/public/css/product-description.css">
    <link rel="icon" type="image/png" sizes="64x64" href="/public/images/favicon.png">
    <meta name="keywords" content="FLOWERIDA, цветы, растения, клумбы, декор, луковицы, семена, корневище" />
    <meta name="description" content="FLOWERIDA - интернет-магазин по продаже живых цветов, семян, луковиц и много другого. Все, что нужно для красивой клумбы." />
   </head>
<body>
 {{{importedIcons}}}
<header class="header header-single-line">

        <div class="header-single-line__content size--5">
            <div class="header-single-line__item header-single-line__item--logo">
                <div class="header__logo text-left clearfix">
                    <div class="header__heading">
                         <a href="/" class="header__heading-link focus-inset">
                         <img src="/images/favicon.png" alt="Flowerida" srcset="/images/favicon.png" width="50" height="50" class="header__heading-logo motion-reduce">
                        </a> 
                    </div>
                    <div> Flowerida</div>
                </div>
            </div>
        </div>
        
        <form action="/search" method="get" role="search" class="search search-modal__form">
            <div class="field">
                <button class="button search__button field__button focus-inset" aria-label="Search">
                    <svg role="img" class="icon icon-search" style="display: inline-block;">
                        <use href="#icon-search"></use></svg>
                </button>
                <input class="search__input field__input form-input-placeholder" id="Search-In-Modal-Single" type="search" name="q" value="" placeholder="Search" autocomplete="off" role="combobox" aria-expanded="false" aria-owns="predictive-search-results-list" aria-controls="predictive-search-results-list" aria-haspopup="listbox" aria-autocomplete="list" autocorrect="off" autocapitalize="off" spellcheck="false">
                <input type="hidden" name="options[prefix]" value="last">
                <input type="hidden" name="type" value="product">

            </div>
        <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
    </form>
<div class="userActivites">
    <div class="header-single-line__item header-single-line__item--customer">
        <div class="header__iconItem header__group">
            {{#if user}}
            <a href="/cabinet" class="header__icon header__icon--account link link--text">
            <svg class="icon icon-account" width="18px" height="50px">
                <use href="#icon-user"></use>
            </svg>
                <span class="customer-links">Привет, {{user.name}}</span>
            </a>
            {{else}}
                <a href="/login" class="header__icon header__icon--account link link--text">
                <svg class="icon icon-account" width="18px" height="50px">
                    <use href="#icon-user"></use></svg>
                <span class="customer-links">Sign In</span>
                </a>
            {{/if}}                    
        </div>
    </div>

    <div class="header-single-line__item header-single-line__item--wishlist">
        <div class="header__iconItem header__group">
            <a href="/favorites" class="header__icon header__icon--wishlist link link--text focus-inset">
            <svg role="img" class="icon icon-wishlist w-h-" width="18px" height="50px">
                <use href="#icon-favorites"></use>
            </svg>
                <span class="wishlist-text">Wish Lists</span>
            </a>
        </div>
    </div>
    <div class="header-single-line__item header-single-line__item--cart">
        <div class="header__iconItem header__group " style="--color: #232323; --cart-bg-item: #000000; --cart-color-item: #ffffff; --cart-item-font-size: 14px">
            <a href="/cart" class="header__icon header__icon--cart link link--text focus-inset cart-icon-bubble" data-cart-sidebar="">
                <svg  class="icon icon-cart  stroke-w-5" width="18px" height="50px">
                    <use href="#icon-cart"></use>
                </svg>
                <span class="cart-text">Cart</span>
                <div class="cart-count-bubble">
                    <span class="text" aria-hidden="true" data-cart-count="">{{cartCount}}</span>
                    <span class="visually-hidden" style="visibility: hidden; font-size:3px;">0 items</span>
                </div> 
            </a>
        </div>
    </div>           
 </div>        


</header>
<div id="single_line">
    <div id="single_line_catalog">
        <a href="/catalog">⋙ Каталог</a>
        
     </div>
    {{#ifEquals user.role "ADMIN"}}
    <div id="single_line_admin">
        <a href="/adminka"> ⋙ Админка</a>
    </div>
    {{/ifEquals}}
</div>
   {{{ conteiner }}}

<footer>
    <div id="footer_contact">
        <div style="padding-left: 20px;">
            <div>Магазин FLOWERIDA</div>
            <div>г. Могилев ул.Первомайская,1</div>
        </div>
        <div style="padding-right: 20px;">
            <div>т. +375-29-111-11-11</div>
            <div>Почта: mail@flowerida.by</div>
        </div>
    </div>
    <img src="/images/footer_bg.png" alt="footerBackground">
</footer>

</body>

</html>
