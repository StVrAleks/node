{{#section 'css'}}
    <link rel="stylesheet" href="/public/css/pages/page-admin.css">
{{/section}}

<div id="conteiner" class="admin-page-viewport">
    <!-- 1. Верхняя панель переключения разделов -->
    <header class="admin-sections-panel">
        <div class="admin-sections-group">
            <button type="button" id="control_services_flower" class="btn-ops btn--secondary">Цветы</button>
            <button type="button" id="control_services_vid" class="btn-ops btn--secondary">Виды цветов</button>
            <button type="button" id="control_services_user" class="btn-ops btn--secondary">Пользователи</button>
        </div>
    </header>

    <div id="conteiner_services">
        <div id="control_div_table">
            <span id="mist3" class="mistake"></span>
            
            <!-- Яркий выделенный ряд управления: Добавление + Пагинация -->
            <div id="control_admin" class="admin-action-bar">
                <div id="service_add" class="add-action-box">
                    <!-- Сюда JS вставит кнопку "+ Добавить новый цветок" -->
                </div>
                
                <div id="pageView" class="pagination-container pagination-relaxed">
                    <button id="pre" class="btn-ops btn--outline btn--small"><< Назад</button>
                    <span id="page_indicator">Страница 1 из 1</span>
                    <button id="next" class="btn-ops btn--outline btn--small">Вперед >></button>
                </div>
            </div>

            <!-- Контейнер для таблицы со скроллом, прижатый влево -->
            <div class="admin-table-scroll-viewport">
                <table id="control_table"></table>
            </div>
        </div>
    </div> 
</div>

<!-- ЕДИНСТВЕННОЕ УНИВЕРСАЛЬНОЕ МОДАЛЬНОЕ ОКНО С ЗОНОЙ ДЛЯ ПЕРЕТАСКИВАНИЯ -->
<div class="hystmodal" id="adminUniversalModal" style="display: none;">
    <div class="hystmodal__window">  
        <!-- Шапка окна, за которую можно будет перетаскивать (как в SharePoint) -->
        <div class="modal-drag-handler" id="adminModalHandle">
            <span class="drag-title">🗔 Управление элементом</span>
            <div class="drag-dots">•••</div>
        </div>

        <div class="modal-body-content">
            <span id="modalMistake" class="mistake"></span>
            
            <!-- Динамические поля -->
            <div id="modalDynamicContent"></div>
            
            <div id="control_modal">
                <input type="button" id="control_modal_save" class="btn-ops btn--primary" value="Сохранить">
                <input type="button" id="control_modal_cancel" class="btn-ops btn--outline control_modal_close" value="Отменить">
            </div>
        </div>
    </div>
</div>

<script type="module" src="/dist/src/adminka.js"></script>