{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    /* ИСПРАВЛЕНО: Добавили DOM библиотеки, чтобы TypeScript распознал document */
    "lib": ["es2022", "DOM", "DOM.Iterable"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules", 
    "dist", 
    "public", 
    "views"
  ]
}